#!/usr/bin/env python3
"""tests/run — entry point of the integration test system.

Stdlib only. astral-py is a zero-dependency package, so it is imported
straight from its checkout (config.toml astral_py.path) via sys.path —
no venv, no pip (the host lacks ensurepip).
"""
import sys

# why first: tomllib is 3.11's, and macOS's own /usr/bin/python3 is 3.9, which
# would die on the import below with a traceback instead of this line
if sys.version_info < (3, 11):
    sys.exit("run: Python >= 3.11 required (found "
             f"{sys.version.split()[0]} at {sys.executable})")

import argparse
import os
import signal
import tomllib
from pathlib import Path

TESTS = Path(__file__).resolve().parent
_SIGNALLED = []          # the signal that ended the run, when one did

USAGE = """\
examples:
  ./tests/run                        the default suite (suites/main.suite)
  ./tests/run main.suite             a named suite, its listing a preference
  ./tests/run adopt-node             one test + the tests its world needs first
  ./tests/run smoke adopt-node       several tests
  ./tests/run --plan main.suite      the worlds a run would use, with nothing run
  ./tests/run adopt-node --vm --save gw    build a VM world once, save it as gw
  ./tests/run gateway-relay --from gw      run on it, past its history
"""


def astral_src() -> Path:
    from lib.build import missing_commit

    cfg = tomllib.loads((TESTS / "config.toml").read_text())["astral_py"]
    checkout = Path(os.path.expanduser(cfg["path"]))
    src = checkout / "src"
    if not (src / "astral" / "__init__.py").exists():
        sys.exit(f"run: astral-py not found at {src} (config.toml astral_py.path)")
    required = cfg["requires"]
    if reason := missing_commit(checkout, required):
        sys.exit(f"run: astral-py at {checkout}: {reason}; these tests need "
                 f"astral-py {required[:8]} or later "
                 "(config.toml astral_py.requires)")
    return src


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="tests/run", epilog=USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("selection", nargs="*", metavar="SUITE|TEST",
                    help="a suite under suites/, or one or more tests under "
                         "e2e/ (default: main.suite)")
    ap.add_argument("--driver", choices=["script", "agent"], default="script",
                    help="how the flow is performed (default: script)")
    ap.add_argument("--target", choices=["fresh", "attach"], default="fresh",
                    help="where the machines come from: worlds the run "
                         "spawns, or the daemon already up (default: fresh)")
    ap.add_argument("--keep", action="store_true",
                    help="leave the run's last world running after the run")
    ap.add_argument("--plan", action="store_true",
                    help="print the worlds the selection plans into and exit, "
                         "starting nothing")
    ap.add_argument("--isolate", action="store_true",
                    help="run every selected test in a world of its own")
    ap.add_argument("--prereqs", choices=["script", "agent"], default="script",
                    help="who drives prereqs and replays under --driver agent "
                         "(default: script)")
    ap.add_argument("--vm", action="store_true",
                    help="run every world in VMs, local tests included")
    ap.add_argument("--docker", action="store_true",
                    help="run every world in Docker containers, one per "
                         "node; the agent driver's default without netsim")
    ap.add_argument("--save", metavar="NAME",
                    help="save the run's last world, a VM world, as netsim "
                         "stage NAME, its world record inside")
    ap.add_argument("--from", dest="from_stage", metavar="NAME",
                    help="boot the world --save NAME saved, and run only "
                         "what its history has not")
    args = ap.parse_args()

    sys.path.insert(0, str(TESTS))
    src = astral_src()
    sys.path.insert(1, str(src))
    os.environ["ASTRAL_TESTS_PYPATH"] = f"{TESTS}{os.pathsep}{src}"

    from lib import runner
    _trap_signals()
    try:
        return runner.main(args)
    except KeyboardInterrupt:
        # why: a shell stops a loop only on a child that a signal killed,
        # and an exit status cannot say that; the report is already written
        # note: dying of a signal skips the flush, and piped output is
        # block-buffered, so the verdict line would be lost
        sys.stdout.flush()
        sys.stderr.flush()
        sig = _SIGNALLED[0] if _SIGNALLED else signal.SIGINT
        signal.signal(sig, signal.SIG_DFL)
        os.kill(os.getpid(), sig)
        return 128 + sig


def _as_interrupt(signum, _frame):
    _SIGNALLED.append(signum)
    raise KeyboardInterrupt


def _trap_signals():
    """Read SIGTERM and SIGHUP as Ctrl-C, so the run unwinds and reports."""
    # why: a tool's timeout and a closed terminal end a run with these, and
    # Python dies of them without unwinding: no report, and off Linux the
    # nodes outlive the run
    # why not an ignored one: nohup ignores SIGHUP so that the run survives
    for sig in (signal.SIGTERM, signal.SIGHUP):
        if signal.getsignal(sig) != signal.SIG_IGN:
            signal.signal(sig, _as_interrupt)


if __name__ == "__main__":
    sys.exit(main())
