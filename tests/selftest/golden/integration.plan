w0 local:  smoke → claim-window → token-less-setup → signer-app
           → admission-policies → mcp-origin → messaging-ops → manager-setup
           → bootstrap-user-software-key → fs-watch → fs-index-live
           → registration-lease → policy-delegate → adopt-node
           → blueprints-two-node → apphost-origin → sign-contract-guard
           → request-grant-scope → swarm-authz-matrix → services-swarm
           → object-store → mcp-peer → messaging-two-node → object-store-peer
           → read-remote-peer → read-swarm → discover-swarm → expel-node
           config admitter.apphost.policies = {"app_register": "reject_all"}
           config admitter.user.policies = {"swarm_join": "reject_all", "swarm_invite": "accept_all"}
           config invitee.user.policies = {"swarm_join": "accept_all", "swarm_invite": "reject_all"}
           config node1.apphost.gate = {"tokenless": ["apphost.register", "user.info", "user.derive_identity", "user.bootstrap", "user.join"], "states": {"fresh": ["*"], "unclaimed": ["*"]}}
           config node1.objects.external_registration_sweep_interval = "1s"
           config nomcp1.mcp.bind_mcp = ""
